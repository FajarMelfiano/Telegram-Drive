# === Server ===
PORT=8787
# Key enkripsi session & api_hash Telegram (AES-G256-GCM). Wajib 32 byte hex.
# Hasilkan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TURNO_SECRET_KEY=

# JWT app (password acak minimal 32 char) — dipakai untuk tanda tangan JWT
JWT_SECRET=

# === Google Sheets (opsional, bisa diisi nanti) ===
# URL Web App Apps Script (doPost) untuk sinkron baris
SHEETS_WEBHOOK_URL=
# Token rahasia yang sama dikirim di header X-Sheets-Token
SHEETS_TOKEN=
# Interval sinkron (ms)
SHEET_SYNC_INTERVAL_MS=30000

# === Batasan ===
MAX_FILE_BYTES=2147483648
