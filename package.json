{
  "name": "telegram-drive",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @td/shared && npm run build -w @td/server",
  "postinstall": "npm run build -w @td/shared",
    "test": "npm test -ws --if-present",
    "typecheck": "npm run typecheck -ws --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.2": true
  }
}
